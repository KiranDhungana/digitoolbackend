# Pooled connection (app runtime) — port 6543 with ?pgbouncer=true
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true&connection_limit=5&pool_timeout=20"
# Direct connection (migrations + shadow DB) — port 5432, no pgbouncer
DIRECT_URL="postgresql://user:password@host:5432/postgres"
PORT=4000
JWT_SECRET="change-this-to-a-long-random-secret"
CORS_ORIGIN="http://localhost:3000"
ADMIN_EMAIL="admin@digitoolera.local"
ADMIN_PASSWORD="ChangeMe123!"
CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"
FONEPAY_NUMBER="98XXXXXXXX"
FONEPAY_NAME="Digitoolera"
# Gmail SMTP (use an App Password — https://myaccount.google.com/apppasswords)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your@gmail.com"
SMTP_PASS="your-gmail-app-password"
MAIL_FROM="Digitoolera <your@gmail.com>"
SITE_URL="http://localhost:3000"
# Optional: auto-send order details on WhatsApp / Telegram / Viber when API keys are set
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_DEFAULT_CHAT_ID=
# VIBER_AUTH_TOKEN=
